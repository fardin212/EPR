generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// شرکت‌ها / سازمان‌ها
model Company {
  id                    Int                         @id @default(autoincrement())
  name                  String
  code                  String                      @unique
  description           String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  accountingAccounts    AccountingAccount[]
  accountingAssets      AccountingAsset[]
  accountingCostCenters AccountingCostCenter[]
  depreciationRuns      AccountingDepreciationRun[]
  accountingPeriodLocks AccountingPeriodLock[]
  accountingVouchers    AccountingVoucher[]
  attachments           Attachment[]
  bomTemplates          BomTemplate[]
  ContainerBomItem      ContainerBomItem[]
  containerEstimates    ContainerEstimate[]
  containerEstimateBoms ContainerEstimateBom[]
  containerModels       ContainerModel[]
  ContainerSizePreset   ContainerSizePreset[]
  contractors           ContractorProfile[]
  costEstimates         CostEstimate[]
  CostEstimateExtra     CostEstimateExtra[]
  CostEstimateLine      CostEstimateLine[]
  employees             Employee[]
  invoices              Invoice[]
  materials             Material[]
  notifications         Notification[]
  parties               Party[]
  bankAccounts          PartyBankAccount[]
  products              Product[]
  productCategories     ProductCategory[]
  projects              Project[]
  projectCosts          ProjectCost[]
  purchaseExtraCosts    PurchaseExtraCost[]
  stock                 Stock[]
  stockMoves            StockMove[]
  stockTakings          StockTakingSession[]
  treasuryAccounts      TreasuryAccount[]
  treasuryCheques       TreasuryCheque[]
  treasuryPayments      TreasuryPayment[]
  treasuryTransactions  TreasuryTransaction[]
  users                 User[]
  vouchers              Voucher[]
  warehouses            Warehouse[]
}

/// کاربران سیستم
model User {
  id                          Int                         @id @default(autoincrement())
  email                       String                      @unique
  password                    String
  name                        String
  role                        UserRole                    @default(STAFF)
  companyId                   Int
  isActive                    Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  accounts                    Account[]
  lockedAccountingPeriodLocks AccountingPeriodLock[]      @relation("AccountingPeriodLock_LockedBy")
  createdInvoices             Invoice[]                   @relation("Invoice_CreatedBy")
  finalizedInvoices           Invoice[]                   @relation("InvoiceFinalizedBy")
  notifications               Notification[]
  activities                  ProjectActivity[]
  createdProjectCosts         ProjectCost[]               @relation("ProjectCostCreatedBy")
  checklist                   ProjectStageChecklistItem[]
  sessions                    Session[]
  company                     Company                     @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "User_companyId_fkey")
}

/// محصولات / کالاها (مثلاً ورق، پروفیل، ساندویچ پنل و ...)
model Product {
  id                     Int                     @id @default(autoincrement())
  companyId              Int
  sku                    String                  @unique
  name                   String
  description            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoryId             Int?
  minStock               Int                     @default(0)
  packSize               Decimal?
  purchaseUnit           UnitType?
  stockUnit              UnitType
  accountingVoucherItems AccountingVoucherItem[]
  bomItems               BomItem[]
  invoiceItems           InvoiceItem[]           @relation("InvoiceItemProduct")
  category               ProductCategory?        @relation(fields: [categoryId], references: [id])
  company                Company                 @relation(fields: [companyId], references: [id])
  stocks                 Stock[]
  stockMoves             StockMove[]
  stockTakingItems       StockTakingItem[]
  voucherLines           VoucherLine[]

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@index([companyId], map: "Product_companyId_fkey")
}

model TreasuryCheque {
  id         Int               @id @default(autoincrement())
  companyId  Int
  number     String
  bankName   String?
  branch     String?
  accountNo  String?
  iban       String?
  issuerName String?
  payTo      String?
  amount     Decimal           @db.Decimal(18, 2)
  issueDate  DateTime?
  dueDate    DateTime
  status     ChequeStatus      @default(REGISTERED)
  note       String?
  partyId    Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  company    Company           @relation(fields: [companyId], references: [id])
  party      Party?            @relation(fields: [partyId], references: [id])
  payments   TreasuryPayment[]

  @@index([dueDate])
  @@index([status])
  @@index([companyId], map: "TreasuryCheque_companyId_fkey")
  @@index([partyId], map: "TreasuryCheque_partyId_fkey")
}

model PurchaseExtraCost {
  id        Int                       @id @default(autoincrement())
  companyId Int
  voucherId Int
  projectId Int?
  partyId   Int?
  kind      PurchaseExtraCostKind     @default(OTHER)
  title     String
  amount    Decimal                   @db.Decimal(18, 2)
  method    ExtraCostAllocationMethod @default(BY_VALUE)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  company   Company                   @relation(fields: [companyId], references: [id])
  party     Party?                    @relation(fields: [partyId], references: [id])
  project   Project?                  @relation(fields: [projectId], references: [id])
  voucher   AccountingVoucher         @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId])
  @@index([companyId, projectId])
  @@index([partyId], map: "PurchaseExtraCost_partyId_fkey")
  @@index([projectId], map: "PurchaseExtraCost_projectId_fkey")
  @@index([voucherId], map: "PurchaseExtraCost_voucherId_fkey")
}

model ContractorContract {
  id           Int       @id @default(autoincrement())
  projectId    Int
  contractorId Int
  totalAmount  Decimal   @db.Decimal(14, 2)
  description  String?
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contractor   Party     @relation(fields: [contractorId], references: [id])
  project      Project   @relation(fields: [projectId], references: [id])

  @@unique([projectId, contractorId])
  @@index([contractorId], map: "ContractorContract_contractorId_fkey")
}

model TreasuryAccount {
  id                  Int                   @id @default(autoincrement())
  companyId           Int
  title               String
  type                TreasuryAccountType   @default(BANK)
  bankName            String?
  accountNumber       String?
  cardNumber          String?
  iban                String?
  openingBalance      Int                   @default(0)
  isActive            Boolean               @default(true)
  accountingAccountId Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  accountingAccount   AccountingAccount     @relation(fields: [accountingAccountId], references: [id])
  company             Company               @relation(fields: [companyId], references: [id])
  outgoingTxs         TreasuryTransaction[] @relation("TreasuryFromAccount")
  incomingTxs         TreasuryTransaction[] @relation("TreasuryToAccount")

  @@index([companyId])
  @@index([accountingAccountId])
}

model PartyBankAccount {
  id            Int                   @id @default(autoincrement())
  partyId       Int
  title         String
  ownerName     String?
  bankName      String?
  accountNumber String?
  cardNumber    String?
  iban          String?
  isDefault     Boolean               @default(false)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  companyId     Int?
  Company       Company?              @relation(fields: [companyId], references: [id])
  party         Party                 @relation(fields: [partyId], references: [id])
  transactions  TreasuryTransaction[] @relation("TreasuryPartyBankAccount")

  @@index([partyId])
  @@index([companyId], map: "PartyBankAccount_companyId_fkey")
}

model TreasuryTransaction {
  id        Int              @id @default(autoincrement())
  companyId Int
  date      DateTime         @default(now())
  direction TreasuryTxDirection
  method    TreasuryTxMethod
  amount    Decimal          @db.Decimal(18, 2)

  fromAccountId Int?
  toAccountId   Int?

  partyId            Int?
  partyBankAccountId Int?

  trackingNo String?
  refNo      String?
  note       String?

  accountingVoucherId Int?
  type                 TreasuryTransactionType @default(PROJECT)
  accountingAccountId  Int?  // فقط برای GENERAL

  projectId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], map: "TreasuryTransaction_companyId_fkey")

  fromAccount TreasuryAccount? @relation("TreasuryFromAccount", fields: [fromAccountId], references: [id], map: "TreasuryTransaction_fromAccountId_fkey")
  toAccount   TreasuryAccount? @relation("TreasuryToAccount", fields: [toAccountId], references: [id], map: "TreasuryTransaction_toAccountId_fkey")

  party            Party?            @relation(fields: [partyId], references: [id], map: "TreasuryTransaction_partyId_fkey")
  partyBankAccount PartyBankAccount? @relation("TreasuryPartyBankAccount", fields: [partyBankAccountId], references: [id], map: "TreasuryTransaction_partyBankAccountId_fkey")

  project Project? @relation(fields: [projectId], references: [id], map: "TreasuryTransaction_projectId_fkey")
  @@index([companyId, date], map: "TreasuryTransaction_companyId_date_idx")
  @@index([partyId, date], map: "TreasuryTransaction_partyId_date_idx")
  @@index([fromAccountId, date], map: "TreasuryTransaction_fromAccountId_date_idx")
  @@index([toAccountId, date], map: "TreasuryTransaction_toAccountId_date_idx")
}

model Invoice {
  id              Int                @id @default(autoincrement())
  companyId       Int
  docType         InvoiceDocType     @default(PROFORMA)
  status          InvoiceStatus      @default(DRAFT)
  serialNo        Int?
  docNo           String
  date            DateTime           @default(now())
  dueDate         DateTime?
  partyId         Int?
  customerName    String
  customerMobile  String?
  customerPhone   String?
  customerAddress String?
  subtotal        Int                @default(0)
  discount        Int                @default(0)
  shipping        Int                @default(0)
  tax             Int                @default(0)
  total           Int                @default(0)
  deliveryTime    String?
  storagePenalty  String?
  transportTerms  String?
  notes           String?            @db.LongText
  createdById     Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  deletedBy       Int?
  finalizedAt     DateTime?
  finalizedById   Int?
  projectId       Int?
  voucherId       Int?               @unique
  warehouseId     Int?
  company         Company            @relation(fields: [companyId], references: [id])
  createdBy       User?              @relation("Invoice_CreatedBy", fields: [createdById], references: [id])
  finalizedBy     User?              @relation("InvoiceFinalizedBy", fields: [finalizedById], references: [id])
  party           Party?             @relation(fields: [partyId], references: [id])
  project         Project?           @relation("InvoiceProject", fields: [projectId], references: [id], map: "fk_invoice_project")
  voucher         AccountingVoucher? @relation("InvoiceVoucher", fields: [voucherId], references: [id], map: "fk_invoice_voucher")
  warehouse       Warehouse?         @relation("InvoiceWarehouse", fields: [warehouseId], references: [id], map: "fk_invoice_warehouse")
  items           InvoiceItem[]
  spec            InvoiceSpec?
  stockMoves      StockMove[]        @relation("InvoiceStockMoves")

  @@unique([companyId, docType, docNo])
  @@index([companyId, date])
  @@index([companyId, docType, serialNo])
  @@index([partyId])
  @@index([createdById], map: "Invoice_createdById_fkey")
  @@index([finalizedById], map: "Invoice_finalizedById_fkey")
  @@index([projectId], map: "fk_invoice_project")
  @@index([warehouseId], map: "fk_invoice_warehouse")
}

model InvoiceItem {
  id        Int             @id @default(autoincrement())
  invoiceId Int
  title     String
  qty       Decimal         @default(1.00) @db.Decimal(10, 2)
  unit      String?
  unitPrice Int
  lineTotal Int
  sortOrder Int             @default(0)
  note      String?
  createdAt DateTime        @default(now())
  productId Int?
  type      InvoiceItemType @default(PRODUCT)
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product?        @relation("InvoiceItemProduct", fields: [productId], references: [id])

  @@index([invoiceId, sortOrder])
  @@index([productId])
}

model InvoiceSpec {
  id             Int     @id @default(autoincrement())
  invoiceId      Int     @unique
  dimensions     String?
  area           String?
  chassis        String?
  profile        String?
  bodySheet      String?
  roofSheet      String?
  interior       String?
  insulationType String?
  floor          String?
  bodyColor      String?
  door           String?
  window         String?
  extras         String?
  strapSheet     String?
  gutter         String?
  service        String?
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model CrmLead {
  id            Int           @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  source        String?
  status        String?       @default("NEW")
  pipelineStage String?       @default("NEW")
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customerId    Int?
  projectId     Int?
  bomId         Int?
  activities    CrmActivity[]
  bom           BomTemplate?  @relation(fields: [bomId], references: [id])
  customer      CrmCustomer?  @relation(fields: [customerId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])

  @@index([bomId], map: "CrmLead_bomId_fkey")
  @@index([customerId], map: "CrmLead_customerId_fkey")
  @@index([projectId], map: "CrmLead_projectId_fkey")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  companyId Int
  entity    String
  entityId  Int
  kind      String
  fileName  String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, entity, entityId])
}

model Material {
  id                       Int                        @id @default(autoincrement())
  companyId                Int
  name                     String
  unit                     String
  unitPrice                Decimal                    @db.Decimal(18, 2)
  category                 String?
  isActive                 Boolean                    @default(true)
  note                     String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  kgPerBranch              Decimal?                   @db.Decimal(10, 3)
  kgPerPiece               Decimal?                   @db.Decimal(10, 3)
  priceBasis               MaterialPriceBasis         @default(PER_KG)
  bomItems                 ContainerBomItem[]
  ContainerEstimateBomLine ContainerEstimateBomLine[]
  estimateLines            ContainerEstimateLine[]
  CostEstimateLine         CostEstimateLine[]
  company                  Company                    @relation(fields: [companyId], references: [id])
  priceHistory             MaterialPriceHistory[]

  @@index([companyId])
}

model ContainerModel {
  id                  Int                   @id @default(autoincrement())
  companyId           Int
  title               String
  description         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  bomItems            ContainerBomItem[]
  containerEstimates  ContainerEstimate[]   @relation("ContainerModel_ContainerEstimates")
  company             Company               @relation(fields: [companyId], references: [id])
  ContainerSizePreset ContainerSizePreset[]
  estimates           CostEstimate[]

  @@index([companyId])
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  companyId Int
  title     String
  code      String
  nextSeq   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, title])
  @@unique([companyId, code])
  @@index([companyId])
}

model MaterialPriceHistory {
  id         Int      @id @default(autoincrement())
  materialId Int
  companyId  Int
  price      Decimal  @db.Decimal(18, 2)
  changedAt  DateTime @default(now())
  note       String?
  material   Material @relation(fields: [materialId], references: [id])

  @@index([companyId])
  @@index([materialId])
}

model ContainerEstimate {
  id                     Int                            @id @default(autoincrement())
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  estimateType           ContainerEstimateType          @default(STANDARD)
  containerModelId       Int
  sizePresetId           Int
  length                 Float
  width                  Float
  height                 Float
  customerName           String
  customerPhone          String
  projectLocation        String?
  usageType              String?
  validUntil             DateTime?
  deliveryDays           Int?
  paymentTerms           String?                        @db.Text
  warrantyTerms          String?                        @db.Text
  transportTerms         String?                        @db.Text
  notesForCustomer       String?                        @db.Text
  profitType             ProfitType
  profitValue            Float
  materialsTotal         BigInt                         @default(0)
  extrasTotal            BigInt                         @default(0)
  profitAmount           BigInt                         @default(0)
  finalPrice             BigInt                         @default(0)
  spec                   Json?
  specSummary            String?                        @db.Text
  companyId              Int                            @default(1)
  company                Company                        @relation(fields: [companyId], references: [id])
  containerModel         ContainerModel                 @relation("ContainerModel_ContainerEstimates", fields: [containerModelId], references: [id])
  sizePreset             ContainerSizePreset            @relation("SizePreset_ContainerEstimates", fields: [sizePresetId], references: [id])
  ContainerEstimateBom   ContainerEstimateBom?
  displayItems           ContainerEstimateDisplayItem[]
  ContainerEstimateExtra ContainerEstimateExtra[]
  extras                 ContainerEstimateExtra[]       @relation("EstimateExtras")
  ContainerEstimateLine  ContainerEstimateLine[]

  @@index([containerModelId, sizePresetId])
  @@index([companyId], map: "ContainerEstimate_companyId_fkey")
  @@index([sizePresetId], map: "ContainerEstimate_sizePresetId_fkey")
}

model ContainerEstimateLine {
  id                     Int                   @id @default(autoincrement())
  estimateId             Int
  materialId             Int
  qty                    Float
  qtyUnit                EstimateQtyUnit
  unitPrice              BigInt
  lineTotal              BigInt
  note                   String?
  containerEstimateBomId Int?
  bom                    ContainerEstimateBom? @relation(fields: [containerEstimateBomId], references: [id])
  estimate               ContainerEstimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  material               Material              @relation(fields: [materialId], references: [id])

  @@index([containerEstimateBomId], map: "ContainerEstimateLine_containerEstimateBomId_fkey")
  @@index([estimateId], map: "ContainerEstimateLine_estimateId_fkey")
  @@index([materialId], map: "ContainerEstimateLine_materialId_fkey")
}

model ContainerEstimateBom {
  id                    Int                        @id @default(autoincrement())
  companyId             Int
  estimateId            Int                        @unique
  status                ContainerEstimateBomStatus @default(DRAFT)
  lockedAt              DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  finalizedAt           DateTime?
  Company               Company                    @relation(fields: [companyId], references: [id])
  estimate              ContainerEstimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lines                 ContainerEstimateBomLine[]
  ContainerEstimateLine ContainerEstimateLine[]

  @@index([companyId])
}

model ContainerEstimateBomLine {
  id            Int                  @id @default(autoincrement())
  bomId         Int
  materialId    Int
  qty           Float
  qtyUnit       EstimateQtyUnit?
  qtyUnitCustom String?
  unitPrice     BigInt
  lineTotal     BigInt
  note          String?
  bom           ContainerEstimateBom @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material      Material             @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
}

model ContainerEstimateExtra {
  id                  Int                @id @default(autoincrement())
  estimateId          Int
  title               String
  amount              BigInt
  containerEstimateId Int?
  ContainerEstimate   ContainerEstimate? @relation(fields: [containerEstimateId], references: [id])
  estimate            ContainerEstimate  @relation("EstimateExtras", fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([containerEstimateId], map: "ContainerEstimateExtra_containerEstimateId_fkey")
  @@index([estimateId], map: "ContainerEstimateExtra_estimateId_fkey")
}

model ContainerEstimateDisplayItem {
  id         Int               @id @default(autoincrement())
  estimateId Int
  sortOrder  Int               @default(0)
  title      String
  amount     BigInt            @default(0)
  createdAt  DateTime          @default(now())
  estimate   ContainerEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([sortOrder])
}

/// سایزهای محبوب (Preset) بر اساس نوع کانکس
model ContainerSizePreset {
  id               Int                 @id @default(autoincrement())
  companyId        Int
  containerModelId Int?
  title            String
  length           Decimal             @db.Decimal(10, 2)
  width            Decimal             @db.Decimal(10, 2)
  height           Decimal?            @db.Decimal(10, 2)
  isActive         Boolean             @default(true)
  sort             Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  bomItems         ContainerBomItem[]
  estimates        ContainerEstimate[] @relation("SizePreset_ContainerEstimates")
  company          Company             @relation(fields: [companyId], references: [id])
  containerModel   ContainerModel?     @relation(fields: [containerModelId], references: [id])
  CostEstimate     CostEstimate[]

  @@index([companyId])
  @@index([containerModelId])
}

/// BOM (اختیاری) – برای اینکه بعداً بتوانی Template/فرمول هم داشته باشی
model ContainerBomItem {
  id               Int                  @id @default(autoincrement())
  containerModelId Int
  materialId       Int
  calcType         BomCalcType
  factor           Decimal?             @db.Decimal(12, 4)
  minQty           Decimal?             @db.Decimal(12, 4)
  wastePercent     Decimal?             @db.Decimal(5, 2)
  companyId        Int
  createdAt        DateTime             @default(now())
  note             String?
  updatedAt        DateTime             @updatedAt
  fixedQty         Decimal?             @db.Decimal(18, 3)
  qtyUnit          EstimateQtyUnit?
  sizePresetId     Int?
  company          Company              @relation(fields: [companyId], references: [id])
  containerModel   ContainerModel       @relation(fields: [containerModelId], references: [id])
  material         Material             @relation(fields: [materialId], references: [id])
  sizePreset       ContainerSizePreset? @relation(fields: [sizePresetId], references: [id])

  @@unique([companyId, containerModelId, sizePresetId, materialId])
  @@index([companyId, containerModelId, sizePresetId])
  @@index([companyId])
  @@index([containerModelId])
  @@index([materialId])
  @@index([sizePresetId], map: "ContainerBomItem_sizePresetId_fkey")
}

/// پیش‌فاکتور/برآورد کانکس (Snapshot نهایی)
model CostEstimate {
  id               Int                  @id @default(autoincrement())
  companyId        Int
  partyId          Int?
  containerModelId Int
  length           Decimal              @db.Decimal(10, 2)
  width            Decimal              @db.Decimal(10, 2)
  height           Decimal              @db.Decimal(10, 2)
  baseCost         Decimal              @default(0.00) @db.Decimal(18, 2)
  profitType       ProfitType
  profitValue      Decimal              @default(0.00) @db.Decimal(18, 2)
  finalPrice       Decimal              @default(0.00) @db.Decimal(18, 2)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  extrasTotal      Decimal              @default(0.00) @db.Decimal(18, 2)
  materialsTotal   Decimal              @default(0.00) @db.Decimal(18, 2)
  note             String?
  sizePresetId     Int?
  company          Company              @relation(fields: [companyId], references: [id])
  containerModel   ContainerModel       @relation(fields: [containerModelId], references: [id])
  party            Party?               @relation(fields: [partyId], references: [id])
  sizePreset       ContainerSizePreset? @relation(fields: [sizePresetId], references: [id])
  extras           CostEstimateExtra[]
  CostEstimateItem CostEstimateItem[]
  lines            CostEstimateLine[]

  @@index([companyId])
  @@index([partyId])
  @@index([containerModelId])
  @@index([sizePresetId])
}

/// ریزمصرف‌های دستی (تو تعداد/مقدار رو وارد می‌کنی)
model CostEstimateLine {
  id             Int                @id @default(autoincrement())
  companyId      Int
  estimateId     Int
  materialId     Int?
  title          String
  qtyUnit        EstimateQtyUnit
  qty            Decimal            @default(0.0000) @db.Decimal(18, 4)
  derivedKg      Decimal?           @db.Decimal(18, 4)
  unitPriceBasis MaterialPriceBasis
  unitPrice      Decimal            @default(0.00) @db.Decimal(18, 2)
  totalPrice     Decimal            @default(0.00) @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id])
  estimate       CostEstimate       @relation(fields: [estimateId], references: [id])
  material       Material?          @relation(fields: [materialId], references: [id])

  @@index([companyId])
  @@index([estimateId])
  @@index([materialId])
}

/// هزینه‌های دستی (اجرت/رنگ/پیچ‌وچسب/برق‌کشی...)
model CostEstimateExtra {
  id         Int          @id @default(autoincrement())
  title      String
  amount     Decimal      @default(0.00) @db.Decimal(18, 2)
  companyId  Int
  createdAt  DateTime     @default(now())
  estimateId Int
  note       String?
  updatedAt  DateTime     @updatedAt
  company    Company      @relation(fields: [companyId], references: [id])
  estimate   CostEstimate @relation(fields: [estimateId], references: [id])

  @@index([companyId])
  @@index([estimateId])
}

model CostEstimateItem {
  id             Int          @id @default(autoincrement())
  costEstimateId Int
  materialName   String
  unit           String
  quantity       Decimal      @db.Decimal(18, 4)
  unitPrice      Decimal      @db.Decimal(18, 2)
  totalPrice     Decimal      @db.Decimal(18, 2)
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id])

  @@index([costEstimateId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  companyId Int
  userId    Int?
  title     String
  body      String?
  type      String
  refType   String?
  refId     Int?
  isRead    Boolean   @default(false)
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([companyId], map: "Notification_companyId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model CrmCustomer {
  id      Int    @id @default(autoincrement())
  partyId Int?   @unique
  party   Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  name        String
  type        String?
  phone       String?       @db.VarChar(50)
  email       String?
  companyName String?
  lastDealAt  DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  activities  CrmActivity[]
  leads       CrmLead[]
}

model CrmActivity {
  id         Int          @id @default(autoincrement())
  type       String
  title      String
  detail     String?
  doneAt     DateTime     @default(now())
  leadId     Int?
  customerId Int?
  createdAt  DateTime     @default(now())
  customer   CrmCustomer? @relation(fields: [customerId], references: [id])
  lead       CrmLead?     @relation(fields: [leadId], references: [id])

  @@index([customerId], map: "CrmActivity_customerId_fkey")
  @@index([leadId], map: "CrmActivity_leadId_fkey")
}

model ProjectCost {
  id          Int                @id @default(autoincrement())
  companyId   Int
  projectId   Int
  date        DateTime           @default(now())
  amount      BigInt
  description String?
  category    String?
  voucherId   Int?
  createdById Int?
  createdAt   DateTime           @default(now())
  company     Company            @relation(fields: [companyId], references: [id])
  createdBy   User?              @relation("ProjectCostCreatedBy", fields: [createdById], references: [id])
  project     Project            @relation(fields: [projectId], references: [id])
  voucher     AccountingVoucher? @relation(fields: [voucherId], references: [id])

  @@index([companyId], map: "ProjectCost_companyId_fkey")
  @@index([createdById], map: "ProjectCost_createdById_fkey")
  @@index([projectId], map: "ProjectCost_projectId_fkey")
  @@index([voucherId], map: "ProjectCost_voucherId_fkey")
}

enum TreasuryTransactionType {
  PROJECT
  GENERAL
  LEGACY
}

/// انبارها
model Warehouse {
  id                    Int                    @id @default(autoincrement())
  companyId             Int
  name                  String
  code                  String                 @unique
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accountingCostCenters AccountingCostCenter[]
  invoices              Invoice[]              @relation("InvoiceWarehouse")
  stocks                Stock[]
  stockMoves            StockMove[]
  stockTakingItems      StockTakingItem[]
  purchaseVouchers      AccountingVoucher[]    @relation("WarehousePurchaseVouchers")
  company               Company                @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "Warehouse_companyId_fkey")
}

/// جلسه‌های انبارگردانی
model StockTakingSession {
  id        Int               @id @default(autoincrement())
  companyId Int
  title     String
  date      DateTime          @default(now())
  status    String
  note      String?
  items     StockTakingItem[]
  company   Company           @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "StockTakingSession_companyId_fkey")
}

/// ردیف‌های انبارگردانی (برای هر کالا در هر انبار)
model StockTakingItem {
  id          Int                @id @default(autoincrement())
  sessionId   Int
  productId   Int
  warehouseId Int
  systemQty   Float
  countedQty  Float
  diffQty     Float
  note        String?
  product     Product            @relation(fields: [productId], references: [id])
  session     StockTakingSession @relation(fields: [sessionId], references: [id])
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])

  @@index([productId], map: "StockTakingItem_productId_fkey")
  @@index([sessionId], map: "StockTakingItem_sessionId_fkey")
  @@index([warehouseId], map: "StockTakingItem_warehouseId_fkey")
}

/// موجودی کالا در هر انبار
model Stock {
  id          Int       @id @default(autoincrement())
  companyId   Int
  productId   Int
  warehouseId Int
  quantity    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@index([productId], map: "Stock_productId_fkey")
  @@index([warehouseId], map: "Stock_warehouseId_fkey")
}

/// اسناد انبار / رسیدها و حواله‌ها
model StockMove {
  id          Int             @id @default(autoincrement())
  companyId   Int
  productId   Int
  warehouseId Int
  qty         Float
  direction   StockDirection
  reference   String?
  projectId   Int?
  stageId     Int?
  createdAt   DateTime        @default(now())
  date        DateTime        @default(now())
  invoiceId   Int?
  company     Company         @relation(fields: [companyId], references: [id])
  invoice     Invoice?        @relation("InvoiceStockMoves", fields: [invoiceId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])
  stage       ProjectStage?   @relation(fields: [stageId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  lines       StockMoveLine[]

  @@index([companyId], map: "StockMove_companyId_fkey")
  @@index([invoiceId], map: "StockMove_invoiceId_fkey")
  @@index([productId], map: "StockMove_productId_fkey")
  @@index([projectId], map: "StockMove_projectId_fkey")
  @@index([stageId], map: "StockMove_stageId_fkey")
  @@index([warehouseId], map: "StockMove_warehouseId_fkey")
}

model StockMoveLine {
  id        Int       @id @default(autoincrement())
  moveId    Int
  productId Int
  qty       Float
  unitCost  Int?
  note      String?
  move      StockMove @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([moveId], map: "StockMoveLine_moveId_fkey")
}

/// طرف‌حساب‌ها: مشتری، کارفرما، پیمانکار، مالک، ...
model Party {
  id                     Int                     @id @default(autoincrement())
  companyId              Int
  type                   PartyType
  name                   String
  phone                  String?
  mobile                 String?
  email                  String?
  nationalId             String?
  companyName            String?
  address                String?
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  description            String?
  kind                   PartyKind
  bankAccountNumber      String?
  bankCardNumber         String?
  bankIban               String?
  accountingVouchers     AccountingVoucher[]
  accountingVoucherItems AccountingVoucherItem[]
  contractorContracts    ContractorContract[]
  contractorProfile      ContractorProfile?
  costEstimates          CostEstimate[]
  employee               Employee?
  invoices               Invoice[]
  company                Company                 @relation(fields: [companyId], references: [id])
  bankAccounts           PartyBankAccount[]
  customerProjects       Project[]               @relation("ProjectCustomer")
  PurchaseExtraCost      PurchaseExtraCost[]
  treasuryCheques        TreasuryCheque[]
  treasuryPayments       TreasuryPayment[]
  treasuryTransactions   TreasuryTransaction[]
  vouchers               Voucher[]
  crmCustomer            CrmCustomer?

  @@index([bankCardNumber])
  @@index([bankIban])
  @@index([companyId], map: "Party_companyId_fkey")
}

model TreasuryPayment {
  id            Int                @id @default(autoincrement())
  companyId     Int
  date          DateTime           @default(now())
  direction     PaymentDirection
  method        PaymentMethod
  amount        Decimal            @db.Decimal(18, 2)
  partyId       Int?
  projectId     Int?
  description   String?
  voucherId     Int?
  chequeId      Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  bankName      String?
  cardFrom      String?
  cardTo        String?
  fromAccountId Int?
  ibanFrom      String?
  ibanTo        String?
  toAccountText String?
  trackingNo    String?
  cheque        TreasuryCheque?    @relation(fields: [chequeId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id])
  party         Party?             @relation(fields: [partyId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id])
  voucher       AccountingVoucher? @relation(fields: [voucherId], references: [id])

  @@index([chequeId], map: "TreasuryPayment_chequeId_fkey")
  @@index([companyId], map: "TreasuryPayment_companyId_fkey")
  @@index([partyId], map: "TreasuryPayment_partyId_fkey")
  @@index([projectId], map: "TreasuryPayment_projectId_fkey")
  @@index([voucherId], map: "TreasuryPayment_voucherId_fkey")
}

/// پروژه‌ها (هر کانکس / قرارداد)
model Project {
  id                     Int                     @id @default(autoincrement())
  title                  String
  type                   String
  projectTypeId          Int?
  size                   String?
  companyId              Int
  code                   String                  @unique
  name                   String
  description            String?
  startDate              DateTime?
  endDate                DateTime?
  status                 Project_status          @default(IN_PROGRESS)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  specFrame              String?                 @db.LongText
  specWalls              String?                 @db.LongText
  specInterior           String?                 @db.LongText
  specMEP                String?                 @db.LongText
  specLogistic           String?                 @db.LongText
  customerId             Int?
  bomTemplateId          Int?
  isDeleted              Boolean                 @default(false)
  deletedAt              DateTime?
  accountingCostCenters  AccountingCostCenter[]
  accountingVouchers     AccountingVoucher[]
  accountingVoucherItems AccountingVoucherItem[]
  contractorContracts    ContractorContract[]
  leads                  CrmLead[]
  invoices               Invoice[]               @relation("InvoiceProject")
  bomTemplate            BomTemplate?            @relation("BomTemplate_Projects", fields: [bomTemplateId], references: [id])
  company                Company                 @relation(fields: [companyId], references: [id])
  customerParty          Party?                  @relation("ProjectCustomer", fields: [customerId], references: [id])
  projectType            ProjectType?            @relation(fields: [projectTypeId], references: [id])
  ProjectActivity        ProjectActivity[]
  contractors            ProjectContractor[]
  costs                  ProjectCost[]
  images                 ProjectImage[]
  stages                 ProjectStage[]
  purchaseExtraCosts     PurchaseExtraCost[]
  stockMoves             StockMove[]
  treasuryPayments       TreasuryPayment[]
  vouchers               Voucher[]
  voucherLines           VoucherLine[]
  treasuryTransactions   TreasuryTransaction[]

  @@index([bomTemplateId], map: "Project_bomTemplateId_fkey")
  @@index([companyId], map: "Project_companyId_fkey")
  @@index([customerId], map: "Project_customerId_fkey")
  @@index([projectTypeId], map: "Project_projectTypeId_fkey")
}

/// مراحل ساخت هر پروژه
model ProjectStage {
  id           Int                         @id @default(autoincrement())
  projectId    Int
  name         String
  status       StageStatus                 @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  note         String?
  images       ProjectImage[]
  project      Project                     @relation(fields: [projectId], references: [id])
  checklist    ProjectStageChecklistItem[]
  consumptions StockMove[]

  @@index([projectId], map: "ProjectStage_projectId_fkey")
}

/// وچر حسابداری / اسناد مالی
model Voucher {
  id        Int           @id @default(autoincrement())
  companyId Int
  projectId Int?
  date      DateTime      @default(now())
  ref       String?
  note      String?
  partyId   Int?
  company   Company       @relation(fields: [companyId], references: [id])
  party     Party?        @relation(fields: [partyId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])
  lines     VoucherLine[]

  @@index([companyId], map: "Voucher_companyId_fkey")
  @@index([partyId], map: "Voucher_partyId_fkey")
  @@index([projectId], map: "Voucher_projectId_fkey")
}

/// ردیف‌های وچر
model VoucherLine {
  id         Int      @id @default(autoincrement())
  voucherId  Int
  projectId  Int?
  productId  Int?
  quantity   Float?
  unitPrice  Float?
  totalPrice Float?
  note       String?
  product    Product? @relation(fields: [productId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  voucher    Voucher  @relation(fields: [voucherId], references: [id])

  @@index([productId], map: "VoucherLine_productId_fkey")
  @@index([projectId], map: "VoucherLine_projectId_fkey")
  @@index([voucherId], map: "VoucherLine_voucherId_fkey")
}

/// لاگ فعالیت‌ها روی پروژه
model ProjectActivity {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([projectId], map: "ProjectActivity_projectId_fkey")
  @@index([userId], map: "ProjectActivity_userId_fkey")
}

/// آیتم‌های QC / چک‌لیست برای هر مرحله
model ProjectStageChecklistItem {
  id                  Int             @id @default(autoincrement())
  stageId             Int
  title               String
  description         String?
  isRequired          Boolean         @default(true)
  status              QCStatus        @default(PENDING)
  checkedAt           DateTime?
  checkedById         Int?
  note                String?
  checklistTemplateId Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  checkedBy           User?           @relation(fields: [checkedById], references: [id])
  qcTemplateItem      QcTemplateItem? @relation(fields: [checklistTemplateId], references: [id])
  stage               ProjectStage    @relation(fields: [stageId], references: [id])

  @@index([checkedById], map: "ProjectStageChecklistItem_checkedById_fkey")
  @@index([checklistTemplateId], map: "ProjectStageChecklistItem_checklistTemplateId_fkey")
  @@index([stageId], map: "ProjectStageChecklistItem_stageId_fkey")
}

model ProjectType {
  id               Int               @id @default(autoincrement())
  name             String
  code             String            @unique
  description      String?
  bomTemplates     BomTemplate[]
  contractorSkills ContractorSkill[]
  projects         Project[]
  templates        QcTemplate[]
}

model QcTemplate {
  id            Int              @id @default(autoincrement())
  projectTypeId Int
  title         String
  isDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  projectType   ProjectType      @relation(fields: [projectTypeId], references: [id])
  items         QcTemplateItem[]

  @@index([projectTypeId], map: "QcTemplate_projectTypeId_fkey")
}

model QcTemplateItem {
  id             Int                         @id @default(autoincrement())
  templateId     Int
  stageOrder     Int
  stageName      String
  title          String
  description    String?
  isRequired     Boolean                     @default(true)
  sortOrder      Int                         @default(0)
  defaultStatus  QCStatus                    @default(PENDING)
  checklistItems ProjectStageChecklistItem[]
  template       QcTemplate                  @relation(fields: [templateId], references: [id])

  @@index([templateId], map: "QcTemplateItem_templateId_fkey")
}

/// تصاویر پروژه و مراحل
model ProjectImage {
  id        Int           @id @default(autoincrement())
  projectId Int
  stageId   Int?
  url       String
  caption   String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  project   Project       @relation(fields: [projectId], references: [id])
  stage     ProjectStage? @relation(fields: [stageId], references: [id])

  @@index([projectId], map: "ProjectImage_projectId_fkey")
  @@index([stageId], map: "ProjectImage_stageId_fkey")
}

/// حساب‌ها / کاربران برای احراز هویت (مثال - NextAuth style)
model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model AccountingAccount {
  id                      Int                     @id @default(autoincrement())
  companyId               Int
  code                    String                  @unique
  name                    String
  type                    AccountingAccountType
  parentId                Int?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  codePath                String?
  isPosting               Boolean                 @default(true)
  level                   AccountingAccountLevel  @default(DETAIL)
  company                 Company                 @relation(fields: [companyId], references: [id])
  parent                  AccountingAccount?      @relation("AccountParent", fields: [parentId], references: [id])
  children                AccountingAccount[]     @relation("AccountParent")
  assetsAsAccumDepAccount AccountingAsset[]       @relation("AccumDepAccount")
  assetsAsAssetAccount    AccountingAsset[]       @relation("AssetAccount")
  assetsAsExpenseAccount  AccountingAsset[]       @relation("AssetExpenseAccount")
  items                   AccountingVoucherItem[]
  treasuryAccounts        TreasuryAccount[]

  @@index([companyId], map: "AccountingAccount_companyId_fkey")
  @@index([parentId], map: "AccountingAccount_parentId_fkey")
}

model AccountingCostCenter {
  id          Int                      @id @default(autoincrement())
  companyId   Int
  code        String                   @unique
  name        String
  type        AccountingCostCenterType
  isActive    Boolean                  @default(true)
  projectId   Int?
  warehouseId Int?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  company     Company                  @relation(fields: [companyId], references: [id])
  project     Project?                 @relation(fields: [projectId], references: [id])
  warehouse   Warehouse?               @relation(fields: [warehouseId], references: [id])
  items       AccountingVoucherItem[]

  @@index([companyId], map: "AccountingCostCenter_companyId_fkey")
  @@index([projectId], map: "AccountingCostCenter_projectId_fkey")
  @@index([warehouseId], map: "AccountingCostCenter_warehouseId_fkey")
}

model AccountingVoucher {
  id          Int                   @id @default(autoincrement())
  companyId   Int
  projectId   Int?
  warehouseId Int?
  warehouse   Warehouse?            @relation("WarehousePurchaseVouchers", fields: [warehouseId], references: [id])
  date        DateTime
  refNo       String                @unique
  type        AccountingVoucherType
  description String?
  totalDebit  Decimal               @default(0.000000000000000000000000000000)
  totalCredit Decimal               @default(0.000000000000000000000000000000)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  partyId     Int?

  // ✅ NEW: Freight
  freightAmount      Decimal? @db.Decimal(18, 2)
  freightToInventory Boolean  @default(true)
  freightAccountId   Int? // optional: only when freightToInventory=false

  depreciationRuns   AccountingDepreciationRun[]
  company            Company                     @relation(fields: [companyId], references: [id])
  party              Party?                      @relation(fields: [partyId], references: [id])
  project            Project?                    @relation(fields: [projectId], references: [id])
  items              AccountingVoucherItem[]
  invoice            Invoice?                    @relation("InvoiceVoucher")
  projectCosts       ProjectCost[]
  purchaseExtraCosts PurchaseExtraCost[]
  treasuryPayments   TreasuryPayment[]

  @@index([companyId], map: "AccountingVoucher_companyId_fkey")
  @@index([partyId], map: "AccountingVoucher_partyId_fkey")
  @@index([projectId], map: "AccountingVoucher_projectId_fkey")
  // ✅ optional index for reporting
  @@index([warehouseId])
  @@index([freightAccountId])
}

model AccountingPeriodLock {
  id         Int      @id @default(autoincrement())
  companyId  Int
  periodFrom DateTime
  periodTo   DateTime
  lockedById Int?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])
  lockedBy   User?    @relation("AccountingPeriodLock_LockedBy", fields: [lockedById], references: [id])

  @@unique([companyId, periodFrom, periodTo])
  @@index([companyId, periodFrom, periodTo])
  @@index([lockedById])
}

model AccountingVoucherItem {
  id             Int                   @id @default(autoincrement())
  voucherId      Int
  accountId      Int
  description    String?
  debit          Decimal               @default(0.00) @db.Decimal(18, 2)
  credit         Decimal               @default(0.00) @db.Decimal(18, 2)
  assetId        Int?
  costCenterId   Int?
  employeeId     Int?
  partyId        Int?
  productId      Int?
  projectId      Int?
  extraCostShare Decimal               @default(0.00) @db.Decimal(18, 2)
  qty            Decimal?              @db.Decimal(18, 3)
  unit           String?
  unitPrice      Decimal?              @db.Decimal(18, 0)
  account        AccountingAccount     @relation(fields: [accountId], references: [id])
  asset          AccountingAsset?      @relation(fields: [assetId], references: [id])
  costCenter     AccountingCostCenter? @relation(fields: [costCenterId], references: [id])
  employee       Employee?             @relation(fields: [employeeId], references: [id])
  party          Party?                @relation(fields: [partyId], references: [id])
  product        Product?              @relation(fields: [productId], references: [id])
  project        Project?              @relation(fields: [projectId], references: [id])
  voucher        AccountingVoucher     @relation(fields: [voucherId], references: [id])

  @@index([accountId], map: "AccountingVoucherItem_accountId_fkey")
  @@index([assetId], map: "AccountingVoucherItem_assetId_fkey")
  @@index([costCenterId], map: "AccountingVoucherItem_costCenterId_fkey")
  @@index([employeeId], map: "AccountingVoucherItem_employeeId_fkey")
  @@index([partyId], map: "AccountingVoucherItem_partyId_fkey")
  @@index([productId], map: "AccountingVoucherItem_productId_fkey")
  @@index([projectId], map: "AccountingVoucherItem_projectId_fkey")
  @@index([voucherId], map: "AccountingVoucherItem_voucherId_fkey")
}

model AccountingAsset {
  id                Int                         @id @default(autoincrement())
  companyId         Int
  code              String                      @unique
  name              String
  category          String?
  acquisitionDate   DateTime
  acquisitionCost   Decimal                     @db.Decimal(18, 2)
  usefulLifeMonths  Int
  salvageValue      Decimal                     @default(0.00) @db.Decimal(18, 2)
  method            AssetDepreciationMethod     @default(STRAIGHT_LINE)
  assetAccountId    Int
  accumDepAccountId Int
  expenseAccountId  Int
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  accumDepAccount   AccountingAccount           @relation("AccumDepAccount", fields: [accumDepAccountId], references: [id])
  assetAccount      AccountingAccount           @relation("AssetAccount", fields: [assetAccountId], references: [id])
  company           Company                     @relation(fields: [companyId], references: [id])
  expenseAccount    AccountingAccount           @relation("AssetExpenseAccount", fields: [expenseAccountId], references: [id])
  depreciationRuns  AccountingDepreciationRun[]
  voucherItems      AccountingVoucherItem[]

  @@index([accumDepAccountId], map: "AccountingAsset_accumDepAccountId_fkey")
  @@index([assetAccountId], map: "AccountingAsset_assetAccountId_fkey")
  @@index([companyId], map: "AccountingAsset_companyId_fkey")
  @@index([expenseAccountId], map: "AccountingAsset_expenseAccountId_fkey")
}

model AccountingDepreciationRun {
  id         Int                @id @default(autoincrement())
  companyId  Int
  assetId    Int
  periodFrom DateTime
  periodTo   DateTime
  amount     Decimal            @db.Decimal(18, 2)
  voucherId  Int?
  createdAt  DateTime           @default(now())
  asset      AccountingAsset    @relation(fields: [assetId], references: [id])
  company    Company            @relation(fields: [companyId], references: [id])
  voucher    AccountingVoucher? @relation(fields: [voucherId], references: [id])

  @@index([assetId], map: "AccountingDepreciationRun_assetId_fkey")
  @@index([companyId], map: "AccountingDepreciationRun_companyId_fkey")
  @@index([voucherId], map: "AccountingDepreciationRun_voucherId_fkey")
}

/// نشست‌های لاگین
model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Session_userId_fkey")
}

/// توکن‌های ایمیل / ریکاوری
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

/// پروفایل پیمانکار
model ContractorProfile {
  id           Int                 @id @default(autoincrement())
  companyId    Int
  partyId      Int                 @unique
  specialty    String?
  note         String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  dayRate      Decimal?            @db.Decimal(12, 2)
  company      Company             @relation(fields: [companyId], references: [id])
  party        Party               @relation(fields: [partyId], references: [id])
  skills       ContractorSkill[]
  projectLinks ProjectContractor[]

  @@index([companyId], map: "ContractorProfile_companyId_fkey")
}

/// مهارت‌های پیمانکار (نوع کانکس، زمینه تخصصی و...)
model ContractorSkill {
  id            Int               @id @default(autoincrement())
  contractorId  Int
  category      String
  projectTypeId Int?
  description   String?
  level         Int?
  name          String
  contractor    ContractorProfile @relation(fields: [contractorId], references: [id])
  projectType   ProjectType?      @relation(fields: [projectTypeId], references: [id])

  @@index([contractorId], map: "ContractorSkill_contractorId_fkey")
  @@index([projectTypeId], map: "ContractorSkill_projectTypeId_fkey")
}

model ProjectContractor {
  id           Int                     @id @default(autoincrement())
  projectId    Int
  contractorId Int
  role         String?
  note         String?
  agreedAmount Decimal                 @default(0.00) @db.Decimal(18, 2)
  companyId    Int
  createdAt    DateTime                @default(now())
  endDate      DateTime?
  startDate    DateTime?
  status       ProjectContractorStatus @default(ACTIVE)
  updatedAt    DateTime                @updatedAt
  contractor   ContractorProfile       @relation(fields: [contractorId], references: [id])
  project      Project                 @relation(fields: [projectId], references: [id])

  @@unique([projectId, contractorId], map: "ProjectContractor_project_contractor_unique")
  @@index([companyId])
  @@index([contractorId], map: "ProjectContractor_contractorId_fkey")
  @@index([projectId], map: "ProjectContractor_projectId_fkey")
}

model BomTemplate {
  id            Int          @id @default(autoincrement())
  companyId     Int
  projectTypeId Int?
  title         String
  description   String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  name          String
  items         BomItem[]    @relation("BomTemplate_BomItems")
  company       Company      @relation(fields: [companyId], references: [id])
  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  leads         CrmLead[]
  projects      Project[]    @relation("BomTemplate_Projects")

  @@index([companyId], map: "BomTemplate_companyId_fkey")
  @@index([projectTypeId], map: "BomTemplate_projectTypeId_fkey")
}

model BomItem {
  id              Int         @id @default(autoincrement())
  productId       Int
  quantityPerUnit Float
  note            String?
  bomId           Int
  quantity        Float
  stageName       String?
  unit            String?
  bom             BomTemplate @relation("BomTemplate_BomItems", fields: [bomId], references: [id])
  product         Product     @relation(fields: [productId], references: [id])

  @@index([bomId], map: "BomItem_bomId_fkey")
  @@index([productId], map: "BomItem_productId_fkey")
}

/// پروفایل کارمند
model Employee {
  id                     Int                     @id @default(autoincrement())
  companyId              Int
  partyId                Int                     @unique
  code                   String                  @unique
  position               String?
  hireDate               DateTime?
  status                 EmployeeStatus          @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now())
  accountingVoucherItems AccountingVoucherItem[]
  attendances            Attendance[]
  company                Company                 @relation(fields: [companyId], references: [id])
  party                  Party                   @relation(fields: [partyId], references: [id])
  insuranceRecords       InsuranceRecord[]

  @@index([companyId], map: "Employee_companyId_fkey")
}

/// حضور و غیاب
model Attendance {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  overtimeMinutes Int?
  note            String?
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Attendance_employeeId_fkey")
}

/// سوابق بیمه
model InsuranceRecord {
  id         Int           @id @default(autoincrement())
  employeeId Int
  year       Int
  month      Int
  type       InsuranceType
  amount     Decimal       @default(0.000000000000000000000000000000)
  employee   Employee      @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "InsuranceRecord_employeeId_fkey")
}

