generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  imageUrl  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  projects  Project[]

  @@index([parentId], map: "Category_parentId_fkey")
}

model Project {
  id            Int            @id @default(autoincrement())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  title         String
  slug          String         @unique
  summary       String?
  description   String?        @db.Text
  categoryId    Int?
  city          String?
  meters        Int?
  metaTitle     String?
  metaDesc      String?
  heroAlt       String?
  bullets       String?        @db.LongText
  gallery       String?        @db.LongText
  specFrame     String?
  specWalls     String?
  specInterior  String?
  specMEP       String?
  specLogistic  String?
  priceRange    String?
  priceFactors  String?
  challenges    String?
  clientName    String?
  clientQuote   String?
  ctaWhatsapp   String?
  faq           String?        @db.LongText
  linksText     String?
  imageUrl      String?        @db.Text
  category      Category?      @relation(fields: [categoryId], references: [id])
  projectImages ProjectImage[]

  @@index([categoryId], map: "Project_categoryId_fkey")
}

model ProjectQuestion {
  id         Int              @id @default(autoincrement())
  projectId  Int
  name       String
  phone      String?
  question   String
  answer     String?
  status     ModerationStatus @default(approved)
  createdAt  DateTime         @default(now())
  answeredAt DateTime?

  @@index([projectId, status, createdAt])
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  project   Project @relation(fields: [projectId], references: [id])
  projectId Int
}

model ProjectComment {
  id        Int              @id @default(autoincrement())
  projectId Int
  name      String
  rating    Int              @default(5)
  body      String
  status    ModerationStatus @default(approved)
  createdAt DateTime         @default(now())

  @@index([projectId, status, createdAt])
  @@index([projectId, rating])
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  projectId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId], map: "Image_projectId_fkey")
}

/// *
/// * ===========================
/// * Banners (for homepage slider)
/// * ===========================
model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String
  link      String?
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id            Int         @id @default(autoincrement())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastMessageAt DateTime?
  status        ChatStatus  @default(OPEN)
  name          String?
  phone         String?
  source        ChatSource?
  stage         ChatStage   @default(NEW)
  deletedAt     DateTime?

  // ✅ اضافه شود
  messages Message[]

  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id        Int         @id @default(autoincrement())
  sessionId Int
  role      MessageRole @default(USER)
  content   String
  createdAt DateTime    @default(now())

  // ✅ اضافه شود (relation معکوس)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
}

/// *
/// * (Legacy) اگر قبلاً از تک‌جدولی ChatMessage استفاده می‌کردی؛
/// * نگه داشتنش الزام ندارد، اما حذفش هم مشکلی ندارد.
model ChatMessage {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  ip        String?
  name      String?
  phone     String?
  text      String
  source    ChatSource @default(ONLINE)
  meta      String?    @db.LongText
}

model Order {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  name        String
  phone       String
  city        String?
  type        OrderType
  status      OrderStatus @default(NEW)
  length      String?
  width       String?
  height      String?
  insulation  String?
  electricity String?
  plumbing    String?
  delivery    String?
  frame       String?
  facade      String?
  windows     String?
  rooms       String?
  wc          String?
  size        String?
  condition   String?
  doors       String?
  mods        String?
  notes       String?
  source      String?     @default("ONLINE")
  ip          String?
  imagesJson  String?

  @@index([status])
  @@index([createdAt])
}

model AdminMessage {
  id        String   @id @default(cuid())
  message   String
  sessionId String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  id           Int      @id @default(1)
  siteName        String?
  logoUrl         String?
  heroUrl         String?
  brandPrimary    String?  @default("#0B1220")
  brandAccent     String?  @default("#FF7A1A")
  updatedAt       DateTime @updatedAt
  chatEnabled     Boolean  @default(false)
  whatsapp        String?
  telegram        String?
  supportPhone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  status      PostStatus @default(draft)
  excerpt     String?
  body        String?
  coverUrl    String?
  coverAlt    String?
  category    String?
  metaTitle   String?
  metaDesc    String?
  canonical   String?
  ogTitle     String?
  ogImage     String?
  readMinutes Int?
  toc         Boolean    @default(false)
  noindex     Boolean    @default(false)
  nofollow    Boolean    @default(false)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([featured, publishedAt])
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model PostToTag {
  A Int
  B Int

  @@unique([A, B], map: "_PostToTag_AB_unique")
  @@index([B], map: "_PostToTag_B_index")
  @@map("_PostToTag")
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum PostStatus {
  draft
  published
  pending
}

enum MessageRole {
  USER
  ADMIN
  SYSTEM
}

enum ChatStatus {
  OPEN
  CLOSED
  ARCHIVED
  SPAM
}

enum ChatStage {
  NEW
  IN_PROGRESS
  DONE
}

enum ChatSource {
  ONLINE
  WHATSAPP
  TELEGRAM
}

enum OrderType {
  CONEX
  CONTAINER
  REPAIR
}

enum OrderStatus {
  NEW
  SEEN
  QUOTED
  WON
  LOST
  DONE
  IN_PROGRESS
  NOT_DONE
  ARCHIVED
}
